<Window x:Class="ChecklistInstaller.EditarEtapaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckQ - Editar etapa"
        Icon="/CheckQ;component/Assets/CheckQ_icon_1024.png"
        Width="450"
        Height="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Editar etapa"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Descrição"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtDescricao"
                     Height="40"
                     Padding="8"/>

        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="BtnCancelar_Click"/>

            <Button Content="Salvar"
                    Width="100"
                    Height="35"
                    Click="BtnSalvar_Click"/>

        </StackPanel>

    </Grid>

</Window>
