<Window x:Class="ChecklistInstaller.NovoProcessoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckQ - Novo processo"
        Icon="/CheckQ;component/Assets/CheckQ_icon_1024.png"
        Width="500"
        Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <!-- Estilo local BotaoPrincipal. O botão Criar processo abaixo usa outro estilo: BotaoPrimario. -->
    <Window.Resources>

        <Style x:Key="BotaoPrincipal"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#5B4BDB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Novo processo"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#20232A"/>

            <TextBlock Text="Preencha as informações abaixo para criar um novo processo."
                       FontSize="13"
                       Foreground="#707784"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Campo do responsável. A obrigatoriedade é conferida em BtnCriar_Click, no arquivo NovoProcessoWindow.xaml.cs. -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="Usuário responsável"
                       FontWeight="SemiBold"
                       Foreground="#30343B"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtUsuario"
                     Height="35"
                     Padding="8"/>

        </StackPanel>


        <!-- Permite escolher um sistema salvo ou digitar um novo. As opções vêm de CarregarSistemas. -->

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,15">

            <TextBlock Text="Sistema"
                       FontWeight="SemiBold"
                       Foreground="#30343B"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="cmbSistema"
                      Height="35"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      Padding="8"/>

        </StackPanel>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,15">

            <TextBlock Text="Título do processo"
                       FontWeight="SemiBold"
                       Foreground="#30343B"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtTitulo"
                     Height="35"
                     Padding="8"/>

        </StackPanel>


        <!-- Texto de ajuda sobre a escolha ou o cadastro de um sistema. -->

        <Border Grid.Row="4"
                Background="#EAECF2"
                CornerRadius="8"
                Padding="15"
                VerticalAlignment="Top">

            <TextBlock Text="Você pode selecionar um sistema existente ou digitar um sistema novo."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#666D78"/>

        </Border>


        <!-- Ações do formulário. Veja BtnCancelar_Click e BtnCriar_Click em NovoProcessoWindow.xaml.cs. -->

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="BtnCancelar_Click"/>

            <Button Content="Criar processo"
                    Width="130"
                    Height="38"
                    Style="{StaticResource BotaoPrimario}"
                    Click="BtnCriar_Click"/>

        </StackPanel>

    </Grid>

</Window>
