<Window x:Class="ChecklistInstaller.ProcessoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckQ"
        Icon="/CheckQ;component/Assets/CheckQ_icon_1024.png"
        Width="720"
        Height="700"
        MinWidth="650"
        MinHeight="600"
        Foreground="{DynamicResource AzulEscuro}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fundo}">

    <Grid>

        <!-- Marca de fundo: ajuste aqui a imagem, o tamanho e a transparência. -->
        <Image Source="/CheckQ;component/Assets/checklist_logo_transparente.png"
               Width="430"
               Height="430"
               Stretch="Uniform"
               Opacity="0.055"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>


        <!-- Organização da tela: cabeçalho, lista de etapas, campo para adicionar e progresso. -->
        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- Título, responsável e sistema: os valores são preenchidos ao abrir ProcessoWindow.xaml.cs. -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock x:Name="txtTituloProcesso"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AzulEscuro}"/>

                <TextBlock x:Name="txtInformacoes"
                           FontSize="14"
                           Foreground="{DynamicResource TextoSecundario}"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- Área da lista. O visual de cada etapa fica em CriarCardEtapa, no arquivo ProcessoWindow.xaml.cs. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Painel}"
                    BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="painelEtapas"/>

                </ScrollViewer>

            </Border>


            <!-- Campo e botão para uma nova etapa. A ação fica em BtnAdicionarEtapa_Click. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Superficie}"
                    BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,15,0,15">

                <StackPanel>

                    <TextBlock Text="Adicionar etapa"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AzulEscuro}"
                               Margin="0,0,0,10"/>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="120"/>

                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtNovaEtapa"
                                 Grid.Column="0"
                                 Height="40"
                                 Padding="10"
                                 KeyDown="TxtNovaEtapa_KeyDown"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Adicionar"
                                Width="110"
                                Height="40"
                                Margin="10,0,0,0"
                                Background="{DynamicResource AzulPrincipal}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="BtnAdicionarEtapa_Click"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- Visual do progresso. A contagem e o preenchimento da barra ficam em AtualizarProgresso. -->
            <StackPanel Grid.Row="3">

                <TextBlock x:Name="txtProgresso"
                           Text="Progresso: 0 / 0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AzulEscuro}"
                           Margin="0,0,0,6"/>

                <ProgressBar x:Name="barraProgresso"
                             Height="18"
                             Minimum="0"
                             Maximum="100"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
