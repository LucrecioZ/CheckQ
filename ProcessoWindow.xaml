<Window x:Class="ChecklistInstaller.ProcessoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckQ"
        Icon="/CheckQ;component/Assets/CheckQ_icon_1024.png"
        Width="720"
        Height="700"
        MinWidth="650"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FA">

    <Grid>

        <!-- LOGO DE FUNDO -->
        <Image Source="/CheckQ;component/Assets/checklist_logo_transparente.png"
               Width="430"
               Height="430"
               Stretch="Uniform"
               Opacity="0.055"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>


        <!-- CONTEÚDO -->
        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- CABEÇALHO -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock x:Name="txtTituloProcesso"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#193652"/>

                <TextBlock x:Name="txtInformacoes"
                           FontSize="14"
                           Foreground="#687789"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- LISTA DE ETAPAS -->
            <Border Grid.Row="1"
                    Background="#EAF0F5"
                    BorderBrush="#D9E2EA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="painelEtapas"/>

                </ScrollViewer>

            </Border>


            <!-- ADICIONAR ETAPA -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D9E2EA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,15,0,15">

                <StackPanel>

                    <TextBlock Text="Adicionar etapa"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#193652"
                               Margin="0,0,0,10"/>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="120"/>

                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtNovaEtapa"
                                 Grid.Column="0"
                                 Height="40"
                                 Padding="10"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Adicionar"
                                Width="110"
                                Height="40"
                                Margin="10,0,0,0"
                                Background="#087FC1"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="BtnAdicionarEtapa_Click"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- PROGRESSO -->
            <StackPanel Grid.Row="3">

                <TextBlock x:Name="txtProgresso"
                           Text="Progresso: 0 / 0"
                           FontWeight="SemiBold"
                           Foreground="#193652"
                           Margin="0,0,0,6"/>

                <ProgressBar x:Name="barraProgresso"
                             Height="18"
                             Minimum="0"
                             Maximum="100"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
