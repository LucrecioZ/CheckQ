<Application x:Class="ChecklistInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Claro.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- BOTÃO BASE -->

        <Style x:Key="BotaoBase"
               TargetType="Button">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="{DynamicResource Superficie}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AzulEscuro}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource Borda}"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="fundo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="fundo"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="fundo"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTÃO PADRÃO -->

        <Style TargetType="Button"
               BasedOn="{StaticResource BotaoBase}"/>


        <!-- BOTÃO AZUL -->

        <Style x:Key="BotaoPrimario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="{DynamicResource AzulPrincipal}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

        </Style>


        <!-- BOTÃO SECUNDÁRIO -->

        <Style x:Key="BotaoSecundario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="{DynamicResource Superficie}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AzulEscuro}"/>

        </Style>


        <!-- BOTÃO EXCLUIR -->

        <Style x:Key="BotaoPerigo"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="{DynamicResource Superficie}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource Vermelho}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BordaPerigo}"/>

        </Style>


        <!-- BOTÃO DO CARD -->

        <Style x:Key="BotaoCard"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="20,10"/>

        </Style>


        <!-- TEXTBOX -->

        <Style TargetType="TextBox">
            <Setter Property="CaretBrush" Value="{DynamicResource AzulEscuro}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Selecao}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AzulEscuro}"/>

            <Setter Property="Background"
                    Value="{DynamicResource Superficie}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource Borda}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,7"/>

        </Style>


        <!-- COMBOBOX -->

        <!-- COMBOBOX -->
<Style TargetType="ComboBox">

    <Setter Property="ScrollViewer.CanContentScroll"
            Value="True"/>

    <Setter Property="FontSize"
            Value="14"/>

    <Setter Property="Foreground"
            Value="{DynamicResource AzulEscuro}"/>

    <Setter Property="Background"
            Value="{DynamicResource Superficie}"/>

    <Setter Property="BorderBrush"
            Value="{DynamicResource Borda}"/>

    <Setter Property="BorderThickness"
            Value="1"/>

    <Setter Property="Padding"
            Value="10,0"/>

    <Setter Property="VerticalContentAlignment"
            Value="Center"/>


    <Setter Property="Template">

        <Setter.Value>

            <ControlTemplate TargetType="ComboBox">

                <Grid>

                    <!-- FUNDO DO CAMPO -->
                    <Border Background="{DynamicResource Superficie}"
                            BorderBrush="{DynamicResource Borda}"
                            BorderThickness="1"
                            CornerRadius="3"/>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="30"/>

                        </Grid.ColumnDefinitions>


                        <!-- TEXTO NORMALMENTE SELECIONADO -->

                        <ContentPresenter x:Name="selecionado"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          TextElement.Foreground="{DynamicResource AzulEscuro}"/>


                        <!-- CAMPO PARA DIGITAR -->

                        <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 Background="{DynamicResource Superficie}"
                                 Foreground="{DynamicResource AzulEscuro}"
                                 BorderThickness="0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource AzulEscuro}"
                                 SelectionBrush="{DynamicResource Selecao}">

                            <TextBox.Template>

                                <ControlTemplate TargetType="TextBox">

                                    <Border Background="{DynamicResource Superficie}">

                                        <ScrollViewer x:Name="PART_ContentHost"/>

                                    </Border>

                                </ControlTemplate>

                            </TextBox.Template>

                        </TextBox>


                        <!-- BOTÃO DA LISTA -->

                        <ToggleButton Grid.Column="1"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent},
                                          Mode=TwoWay}">

                            <ToggleButton.Template>

                                <ControlTemplate TargetType="ToggleButton">

                                    <Border Background="{DynamicResource Superficie}"
                                            CornerRadius="0,3,3,0">

                                        <Path Data="M 0 0 L 5 5 L 10 0"
                                              StrokeThickness="2"
                                              Stroke="{DynamicResource AzulEscuro}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </ToggleButton.Template>

                        </ToggleButton>

                    </Grid>


                    <!-- LISTA DE SISTEMAS -->

                    <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Focusable="False">

                        <Border Background="{DynamicResource Superficie}"
                                BorderBrush="{DynamicResource Borda}"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>

                            </ScrollViewer>

                        </Border>

                    </Popup>

                </Grid>


                <!-- MODO EDITÁVEL -->

                <ControlTemplate.Triggers>

                    <Trigger Property="IsEditable"
                             Value="True">

                        <Setter TargetName="selecionado"
                                Property="Visibility"
                                Value="Collapsed"/>

                        <Setter TargetName="PART_EditableTextBox"
                                Property="Visibility"
                                Value="Visible"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>

    </Setter>

</Style>


        <!-- CHECKBOX -->

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AzulEscuro}"/>
            <Setter Property="Background" Value="{DynamicResource Superficie}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selecao}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selecao}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AzulEscuro}"/>

        </Style>


        <!-- PROGRESS -->

        <Style TargetType="ProgressBar">

            <Setter Property="Background"
                    Value="{DynamicResource TrilhaProgresso}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AzulPrincipal}"/>

        </Style>

            </ResourceDictionary>
    </Application.Resources>

</Application>
