<Application x:Class="ChecklistInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- CORES -->

        <SolidColorBrush x:Key="AzulPrincipal"
                         Color="#087FC1"/>

        <SolidColorBrush x:Key="AzulHover"
                         Color="#056FA8"/>

        <SolidColorBrush x:Key="Vermelho"
                         Color="#D92B24"/>

        <SolidColorBrush x:Key="AzulEscuro"
                         Color="#193652"/>

        <SolidColorBrush x:Key="Fundo"
                         Color="#F4F7FA"/>

        <SolidColorBrush x:Key="Borda"
                         Color="#D9E2EA"/>

        <SolidColorBrush x:Key="TextoSecundario"
                         Color="#687789"/>


        <!-- BOTÃO BASE -->

        <Style x:Key="BotaoBase"
               TargetType="Button">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AzulEscuro}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource Borda}"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="fundo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <!-- AQUI ESTAVA O PROBLEMA -->
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="fundo"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="fundo"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTÃO PADRÃO -->

        <Style TargetType="Button"
               BasedOn="{StaticResource BotaoBase}"/>


        <!-- BOTÃO AZUL -->

        <Style x:Key="BotaoPrimario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="{StaticResource AzulPrincipal}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

        </Style>


        <!-- BOTÃO SECUNDÁRIO -->

        <Style x:Key="BotaoSecundario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AzulEscuro}"/>

        </Style>


        <!-- BOTÃO EXCLUIR -->

        <Style x:Key="BotaoPerigo"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="{StaticResource Vermelho}"/>

            <Setter Property="BorderBrush"
                    Value="#EBC8C5"/>

        </Style>


        <!-- BOTÃO DO CARD -->

        <Style x:Key="BotaoCard"
               TargetType="Button"
               BasedOn="{StaticResource BotaoBase}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="20,10"/>

        </Style>


        <!-- TEXTBOX -->

        <Style TargetType="TextBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AzulEscuro}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource Borda}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,7"/>

        </Style>


        <!-- COMBOBOX -->

        <Style TargetType="ComboBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AzulEscuro}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource Borda}"/>

        </Style>


        <!-- CHECKBOX -->

        <Style TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AzulEscuro}"/>

        </Style>


        <!-- PROGRESS -->

        <Style TargetType="ProgressBar">

            <Setter Property="Background"
                    Value="#DCE7EE"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AzulPrincipal}"/>

        </Style>

    </Application.Resources>

</Application>
